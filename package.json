{
  "name": "kline-bootcamp",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "PATH=./node_modules/.bin:$PATH npm --prefix apps/api run start:dev",
    "dev:web": "PATH=./node_modules/.bin:$PATH npm --prefix apps/web run dev",
    "build": "PATH=./node_modules/.bin:$PATH npm --prefix apps/api run build && PATH=./node_modules/.bin:$PATH npm --prefix apps/web run build",
    "test": "PATH=./node_modules/.bin:$PATH npm --prefix apps/api run test",
    "import:crypto": "PATH=./node_modules/.bin:$PATH npm --prefix apps/api run import:crypto",
    "import:crypto:offline": "PATH=./node_modules/.bin:$PATH npm --prefix apps/api run import:crypto:offline",
    "aggregate:bars": "PATH=./node_modules/.bin:$PATH npm --prefix apps/api run aggregate:bars",
    "migrate:sqlite:to:pg": "PATH=./node_modules/.bin:$PATH npm --prefix apps/api run migrate:sqlite:to:pg",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "dev:up:local": "bash scripts/dev-up-local.sh",
    "dev:up:lite": "bash scripts/dev-up-lite.sh"
  }
}
