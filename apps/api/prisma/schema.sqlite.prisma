generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_URL")
}

model User {
  id            String                 @id @default(cuid())
  email         String                 @unique
  password      String
  role          String                 @default("USER")
  isBanned      Boolean                @default(false)
  bannedAt      DateTime?
  banReason     String?
  createdAt     DateTime               @default(now())
  accessType    String                 @default("INTERNAL")
  accessStartAt DateTime?
  accessExpiresAt DateTime?
  dailyTrainingLimit Int?
  isTrainingUnlimited Boolean          @default(true)
  learningAccessLevel String           @default("TRAINING")
  accessStatus  String                 @default("ACTIVE")
  currentPlan   String                 @default("NONE")
  accessInviteCodeId String?
  sessions      TrainingSession[]
  redemptions   InviteCodeRedemption[]
  createdInviteCodes InviteCode[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  adminLogs     AdminAuditLog[]        @relation("AdminActorLogs")
  accessSourceInviteCode InviteCode?   @relation("UserAccessSourceInviteCode", fields: [accessInviteCodeId], references: [id])
  trainingDailyUsage UserTrainingDailyUsage[]
  accessChangeLogs UserAccessChangeLog[] @relation("AccessTargetUserLogs")
  operatedAccessChangeLogs UserAccessChangeLog[] @relation("AccessOperatorUserLogs")
  securityLogs  SecurityLog[]
  reviews       TrainingReview[]
  lessonProgress UserLessonProgress[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Symbol {
  id        String      @id @default(cuid())
  market    String
  code      String
  bars      MarketBar[]
  barsCrypto BarCrypto[]
  barsStock BarStock[]
  barsForex BarForex[]
  barsFutures BarFutures[]
  barsGold BarGold[]
  createdAt DateTime    @default(now())

  @@unique([market, code])
}

model MarketBar {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  openTime  DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@index([symbolId, timeframe, openTime])
}

model BarCrypto {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@index([symbolId, timeframe, timestamp])
  @@map("bars_crypto")
}

model BarStock {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@index([symbolId, timeframe, timestamp])
  @@map("bars_stock")
}

model BarForex {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@index([symbolId, timeframe, timestamp])
  @@map("bars_forex")
}

model BarFutures {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@index([symbolId, timeframe, timestamp])
  @@map("bars_futures")
}

model BarGold {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@index([symbolId, timeframe, timestamp])
  @@map("bars_gold")
}

model TrainingSession {
  id                 String            @id @default(cuid())
  userId             String
  market             String
  symbolId           String?
  symbol             String
  drivingTimeframe   String
  totalBars          Int
  initialVisibleBars Int
  initialBalance     Float
  finalBalance       Float?
  isLiquidated       Boolean           @default(false)
  resetCount         Int               @default(0)
  status             String            @default("ACTIVE")
  pointer            Int
  viewTimeframe      String
  barsData           String
  position           Position?
  actions            TrainingAction[]
  snapshots          AccountSnapshot[]
  review             TrainingReview?
  user               User              @relation(fields: [userId], references: [id])
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  terminatedAt       DateTime?
  liquidatedAt       DateTime?
  lastActiveAt       DateTime          @default(now())
  createdAt          DateTime          @default(now())
  endedAt            DateTime?
}

model TrainingReview {
  id          String          @id @default(cuid())
  sessionId   String          @unique
  userId      String
  content     String
  problemTags String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  session     TrainingSession @relation(fields: [sessionId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Position {
  id              String          @id @default(cuid())
  sessionId       String          @unique
  side            String
  entryPrice      Float
  positionPercent Float
  positionAmount  Float
  stopLossRatio   Float?
  takeProfitRatio Float?
  stopLossPrice   Float?
  takeProfitPrice Float?
  feePaid         Float
  openedAtPointer Int
  session         TrainingSession @relation(fields: [sessionId], references: [id])
}

model TrainingAction {
  id              String          @id @default(cuid())
  sessionId       String
  actionType      String
  timePointer     Int
  price           Float
  direction       String?
  amount          Float?
  positionPercent Float?
  closePercent    Float?
  stopLossRatio   Float?
  takeProfitRatio Float?
  pnl             Float?
  realizedPnl     Float?
  fee             Float?
  avgEntryPriceAfter Float?
  positionAmountAfter Float?
  reason          String?
  session         TrainingSession @relation(fields: [sessionId], references: [id])
  createdAt       DateTime        @default(now())

  @@index([sessionId, createdAt])
}

model AccountSnapshot {
  id          String          @id @default(cuid())
  sessionId   String
  timePointer Int
  balance     Float
  floatingPnl Float
  totalEquity Float
  session     TrainingSession @relation(fields: [sessionId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([sessionId, timePointer])
}

model InviteCode {
  id          String                 @id @default(cuid())
  code        String                 @unique
  type        String                 @default("INTERNAL")
  trialDays   Int?
  dailyTrainingLimit Int?
  paidPlan    String                 @default("NONE")
  durationMonths Int?
  isActive    Boolean                @default(true)
  maxUses     Int
  usedCount   Int                    @default(0)
  expiresAt   DateTime?
  createdBy   String?
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?
  createdAt   DateTime               @default(now())
  redemptions InviteCodeRedemption[]
  accessUsers User[]                 @relation("UserAccessSourceInviteCode")
  creator     User?                  @relation(fields: [createdBy], references: [id])
}

model UserTrainingDailyUsage {
  id            String   @id @default(cuid())
  userId        String
  usageDate     DateTime
  trainingCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, usageDate])
  @@index([usageDate])
}

model UserAccessChangeLog {
  id              String   @id @default(cuid())
  userId          String
  operatorUserId  String
  action          String
  oldAccessType   String?
  newAccessType   String?
  oldAccessPlan   String?
  newAccessPlan   String?
  oldExpiresAt    DateTime?
  newExpiresAt    DateTime?
  oldAccessStatus String?
  newAccessStatus String?
  remark          String?
  createdAt       DateTime @default(now())
  user            User     @relation("AccessTargetUserLogs", fields: [userId], references: [id])
  operator        User     @relation("AccessOperatorUserLogs", fields: [operatorUserId], references: [id])

  @@index([userId, createdAt])
  @@index([operatorUserId, createdAt])
}

model InviteCodeRedemption {
  id           String     @id @default(cuid())
  inviteCodeId String
  userId       String
  createdAt    DateTime   @default(now())
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([inviteCodeId, userId])
  @@index([inviteCodeId, createdAt])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AdminAuditLog {
  id           String      @id @default(cuid())
  adminUserId  String
  targetUserId String?
  action       String
  resourceType String
  resourceId   String?
  detail       String?
  createdAt    DateTime    @default(now())
  admin        User        @relation("AdminActorLogs", fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model SecurityLog {
  id        String      @id @default(cuid())
  userId    String?
  action    String
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Course {
  id          String          @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  coverImage  String?
  sortOrder   Int             @default(0)
  status      String          @default("DRAFT")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  chapters    CourseChapter[]

  @@index([status, sortOrder])
  @@map("courses")
}

model CourseChapter {
  id          String       @id @default(cuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int          @default(0)
  status      String       @default("DRAFT")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId, status, sortOrder])
  @@map("course_chapters")
}

model Lesson {
  id             String              @id @default(cuid())
  chapterId      String
  title          String
  type           String
  content        String?
  videoProvider  String?
  videoFileId    String?
  videoUrl       String?
  attachmentUrl  String?
  duration       Int?
  isPreview      Boolean             @default(false)
  accessLevel    String              @default("FULL")
  sortOrder      Int                 @default(0)
  status         String              @default("DRAFT")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  chapter        CourseChapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress       UserLessonProgress[]

  @@index([chapterId, status, sortOrder])
  @@map("lessons")
}

model UserLessonProgress {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  progressSeconds Int      @default(0)
  progressPercent Float    @default(0)
  isCompleted     Boolean  @default(false)
  lastWatchedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@index([lessonId])
  @@map("user_lesson_progress")
}
