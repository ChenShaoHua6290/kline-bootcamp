generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["darwin", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  password           String
  role               UserRole               @default(USER)
  isBanned           Boolean                @default(false)
  bannedAt           DateTime?
  banReason          String?
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  nickname           String?
  accessType         AccessType              @default(INTERNAL)
  accessStartAt      DateTime?
  accessExpiresAt    DateTime?
  dailyTrainingLimit Int?
  isTrainingUnlimited Boolean               @default(true)
  learningAccessLevel LearningAccessLevel   @default(TRAINING)
  accessStatus       AccessStatus            @default(ACTIVE)
  currentPlan        AccessPlan              @default(NONE)
  accessInviteCodeId String?
  adminLogs          AdminAuditLog[]        @relation("AdminActorLogs")
  createdInviteCodes InviteCode[]
  accessSourceInviteCode InviteCode?        @relation("UserAccessSourceInviteCode", fields: [accessInviteCodeId], references: [id])
  trainingDailyUsage UserTrainingDailyUsage[]
  accessChangeLogs   UserAccessChangeLog[]   @relation("AccessTargetUserLogs")
  operatedAccessChangeLogs UserAccessChangeLog[] @relation("AccessOperatorUserLogs")
  redemptions        InviteCodeRedemption[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  securityLogs       SecurityLog[]
  reviews            TrainingReview[]
  lessonProgress     UserLessonProgress[]
  courseAccess       UserCourseAccess[]
  sessions           TrainingSession[]

  @@index([deletedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Symbol {
  id          String            @id @default(cuid())
  market      Market
  code        String
  createdAt   DateTime          @default(now())
  exchange    String?
  displayName String?
  source      String?
  baseAsset   String?
  quoteAsset  String?
  timezone    String?
  isActive    Boolean           @default(true)
  updatedAt   DateTime          @updatedAt
  bars        MarketBar[]
  dataStats   SymbolDataStats[]
  barsCrypto  BarCrypto[]
  barsForex   BarForex[]
  barsFutures BarFutures[]
  barsGold    BarGold[]
  barsStock   BarStock[]

  @@unique([market, code])
}

model MarketBar {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  openTime  DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@index([symbolId, timeframe, openTime])
}

model BarCrypto {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@map("bars_crypto")
}

model BarStock {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@map("bars_stock")
}

model BarForex {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@map("bars_forex")
}

model BarFutures {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@map("bars_futures")
}

model BarGold {
  id        String   @id @default(cuid())
  symbolId  String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  source    String
  createdAt DateTime @default(now())
  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe, timestamp])
  @@map("bars_gold")
}

model TrainingSession {
  id                 String            @id @default(cuid())
  userId             String
  market             Market
  symbolId           String?
  symbol             String
  drivingTimeframe   String
  totalBars          Int
  initialVisibleBars Int
  initialBalance     Float
  finalBalance       Float?
  isLiquidated       Boolean           @default(false)
  resetCount         Int               @default(0)
  status             String            @default("ACTIVE")
  pointer            Int
  viewTimeframe      String
  barsData           Json
  createdAt          DateTime          @default(now())
  endedAt            DateTime?
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  terminatedAt       DateTime?
  liquidatedAt       DateTime?
  lastActiveAt       DateTime          @default(now())
  assignmentSource   String?           @map("assignment_source")
  assignmentId       String?           @map("assignment_id")
  assignmentTitleSnapshot String?      @map("assignment_title_snapshot")
  assignmentVersion  Int?              @map("assignment_version")
  lessonId           String?           @map("lesson_id")
  lessonTitleSnapshot String?          @map("lesson_title_snapshot")
  trainingMode       String?           @map("training_mode")
  attemptNo          Int?              @map("attempt_no")
  isAssignmentContinuation Boolean?    @map("is_assignment_continuation")
  snapshots          AccountSnapshot[]
  position           Position?
  actions            TrainingAction[]
  review             TrainingReview?
  user               User              @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, endedAt])
  @@index([userId, status])
  @@index([userId, assignmentSource])
}

model TrainingReview {
  id          String          @id @default(cuid())
  sessionId   String          @unique
  userId      String
  content     String
  problemTags Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  session     TrainingSession @relation(fields: [sessionId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Position {
  id              String          @id @default(cuid())
  sessionId       String          @unique
  side            PositionSide
  entryPrice      Float
  positionPercent Float
  positionAmount  Float
  stopLossRatio   Float?
  takeProfitRatio Float?
  stopLossPrice   Float?
  takeProfitPrice Float?
  feePaid         Float
  openedAtPointer Int
  session         TrainingSession @relation(fields: [sessionId], references: [id])
}

model TrainingAction {
  id                  String          @id @default(cuid())
  sessionId           String
  actionType          ActionType
  direction           PositionSide?
  timePointer         Int
  price               Float
  amount              Float?
  positionPercent     Float?
  closePercent        Float?
  stopLossRatio       Float?
  takeProfitRatio     Float?
  avgEntryPriceAfter  Float?
  positionAmountAfter Float?
  realizedPnl         Float?
  fee                 Float?
  pnl                 Float?
  reason              CloseReason?
  createdAt           DateTime        @default(now())
  session             TrainingSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
}

model AccountSnapshot {
  id          String          @id @default(cuid())
  sessionId   String
  timePointer Int
  balance     Float
  floatingPnl Float
  totalEquity Float
  createdAt   DateTime        @default(now())
  session     TrainingSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, timePointer])
}

model InviteCode {
  id          String                 @id @default(cuid())
  code        String                 @unique
  type        InviteCodeType         @default(INTERNAL)
  trialDays   Int?
  dailyTrainingLimit Int?
  paidPlan    AccessPlan             @default(NONE)
  durationMonths Int?
  isActive    Boolean                @default(true)
  maxUses     Int
  usedCount   Int                    @default(0)
  expiresAt   DateTime?
  createdBy   String?
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?
  createdAt   DateTime               @default(now())
  creator     User?                  @relation(fields: [createdBy], references: [id])
  accessUsers User[]                 @relation("UserAccessSourceInviteCode")
  redemptions InviteCodeRedemption[]
}

model UserTrainingDailyUsage {
  id            String   @id @default(cuid())
  userId        String
  usageDate     DateTime
  trainingCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, usageDate])
  @@index([usageDate])
}

model UserAccessChangeLog {
  id             String       @id @default(cuid())
  userId         String
  operatorUserId String
  action         String
  oldAccessType  AccessType?
  newAccessType  AccessType?
  oldAccessPlan  AccessPlan?
  newAccessPlan  AccessPlan?
  oldExpiresAt   DateTime?
  newExpiresAt   DateTime?
  oldAccessStatus AccessStatus?
  newAccessStatus AccessStatus?
  remark         String?
  createdAt      DateTime     @default(now())
  user           User         @relation("AccessTargetUserLogs", fields: [userId], references: [id])
  operator       User         @relation("AccessOperatorUserLogs", fields: [operatorUserId], references: [id])

  @@index([userId, createdAt])
  @@index([operatorUserId, createdAt])
}

model InviteCodeRedemption {
  id           String     @id @default(cuid())
  inviteCodeId String
  userId       String
  createdAt    DateTime   @default(now())
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([inviteCodeId, userId])
  @@index([inviteCodeId, createdAt])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AdminAuditLog {
  id           String      @id @default(cuid())
  adminUserId  String
  targetUserId String?
  action       AuditAction
  resourceType String
  resourceId   String?
  detail       String?
  createdAt    DateTime    @default(now())
  admin        User        @relation("AdminActorLogs", fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model SecurityLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model SymbolDataStats {
  id          String    @id @default(cuid())
  symbolId    String
  market      Market
  exchange    String?
  symbol      String
  timeframe   String
  barCount    Int
  startTime   DateTime?
  endTime     DateTime?
  isTrainable Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  symbolRef   Symbol    @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timeframe])
  @@index([market, symbol, timeframe])
}

model Course {
  id          String          @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  coverImage  String?         @map("cover_image")
  relatedLinks Json?           @map("related_links")
  sortOrder   Int             @default(0) @map("sort_order")
  status      CourseStatus    @default(DRAFT)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  chapters    CourseChapter[]
  userAccess  UserCourseAccess[]

  @@index([status, sortOrder])
  @@map("courses")
}

model UserCourseAccess {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  courseId    String            @map("course_id")
  accessLevel CourseAccessLevel @map("access_level")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("user_course_access")
}

model CourseChapter {
  id          String       @id @default(cuid())
  courseId    String       @map("course_id")
  title       String
  description String?
  sortOrder   Int          @default(0) @map("sort_order")
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId, status, sortOrder])
  @@map("course_chapters")
}

model Lesson {
  id             String              @id @default(cuid())
  chapterId      String              @map("chapter_id")
  title          String
  type           LessonType
  content        String?
  videoProvider  String?             @map("video_provider")
  videoFileId    String?             @map("video_file_id")
  videoUrl       String?             @map("video_url")
  attachmentUrl  String?             @map("attachment_url")
  duration       Int?
  isPreview      Boolean             @default(false) @map("is_preview")
  accessLevel    CourseAccessLevel   @default(FULL) @map("access_level")
  sortOrder      Int                 @default(0) @map("sort_order")
  status         CourseStatus        @default(DRAFT)
  trainingAssignment Json?           @map("training_assignment")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  chapter        CourseChapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress       UserLessonProgress[]

  @@index([chapterId, status, sortOrder])
  @@map("lessons")
}

model UserLessonProgress {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  lessonId        String   @map("lesson_id")
  progressSeconds Int      @default(0) @map("progress_seconds")
  progressPercent Float    @default(0) @map("progress_percent")
  isCompleted     Boolean  @default(false) @map("is_completed")
  lastWatchedAt   DateTime? @map("last_watched_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@index([lessonId])
  @@map("user_lesson_progress")
}

enum Market {
  STOCK
  FOREX
  FUTURES
  GOLD
  CRYPTO
}

enum ActionType {
  OPEN_LONG
  OPEN_SHORT
  ADD_LONG
  ADD_SHORT
  PARTIAL_CLOSE
  FULL_CLOSE
  CLOSE
  HOLD
  WAIT
  TP
  SL
  LIQUIDATED
  END
}

enum PositionSide {
  LONG
  SHORT
}

enum CloseReason {
  USER
  TAKE_PROFIT
  STOP_LOSS
  LIQUIDATED
  END_OF_DATA
}

enum UserRole {
  USER
  ADMIN
}

enum AuditAction {
  USER_BAN
  USER_UNBAN
  USER_DELETE
  INVITE_CREATE
  INVITE_UPDATE
  INVITE_DELETE
  USER_COURSE_ACCESS_UPDATE
  LOGIN_FAILED
}

enum InviteCodeType {
  TRIAL
  PAID
  INTERNAL
}

enum AccessType {
  TRIAL
  PAID
  INTERNAL
}

enum AccessStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum AccessPlan {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

enum LearningAccessLevel {
  TRAINING
  FULL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseAccessLevel {
  PREVIEW
  TRAINING
  FULL
  INTERNAL
}

enum LessonType {
  VIDEO
  ARTICLE
  PDF
  MIXED
}
